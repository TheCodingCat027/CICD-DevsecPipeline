{
  "version": "2.1.0",
  "$schema": "https://schemastore.azurewebsites.net/schemas/json/sarif-2.1.0-rtm.5.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "hadolint+checkov",
          "version": "hadolint 2.12.0; checkov 3.2.405",
          "informationUri": "https://github.com/hadolint/hadolint",
          "rules": [
            {
              "id": "CKV_DOCKER_2",
              "name": "CKV_DOCKER_2",
              "shortDescription": {
                "text": "CKV_DOCKER_2"
              },
              "helpUri": "https://docs.bridgecrew.io/docs/ckv-docker-2"
            },
            {
              "id": "CKV_DOCKER_3",
              "name": "CKV_DOCKER_3",
              "shortDescription": {
                "text": "CKV_DOCKER_3"
              },
              "helpUri": "https://docs.bridgecrew.io/docs/ckv-docker-3"
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "CKV_DOCKER_2",
          "level": "warning",
          "message": {
            "text": "[Checkov CKV_DOCKER_2] CKV_DOCKER_2"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "demo-app/vulnerable/Dockerfile"
                },
                "region": {
                  "startLine": 1
                }
              }
            }
          ],
          "properties": {
            "severity": "Medium",
            "category": "iac",
            "raw_severity": "MEDIUM",
            "fix": "Ensure that HEALTHCHECK instructions have been added to the container image"
          }
        },
        {
          "ruleId": "CKV_DOCKER_3",
          "level": "warning",
          "message": {
            "text": "[Checkov CKV_DOCKER_3] CKV_DOCKER_3"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "demo-app/vulnerable/Dockerfile"
                },
                "region": {
                  "startLine": 1
                }
              }
            }
          ],
          "properties": {
            "severity": "Medium",
            "category": "iac",
            "raw_severity": "MEDIUM",
            "fix": "Ensure that a user for the container has been created"
          }
        }
      ]
    }
  ]
}