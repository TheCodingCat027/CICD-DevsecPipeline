{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devsecops-pipeline/contracts/policy.schema.json",
  "title": "SecurityPolicy",
  "description": "Security policy file schema for the DevSecOps pipeline gate",
  "type": "object",
  "required": ["version","mode","secrets","vulnerabilities","container","waivers"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "const": 1,
      "description": "Policy schema version (must be 1)"
    },
    "mode": {
      "type": "string",
      "enum": ["enforce","audit"],
      "description": "enforce: blocks non-compliant deploys. audit: reports only, never blocks."
    },
    "secrets": {
      "type": "object",
      "required": ["max_allowed"],
      "additionalProperties": false,
      "properties": {
        "max_allowed": {
          "type": "integer",
          "minimum": 0,
          "description": "Maximum number of secrets findings allowed before blocking"
        }
      }
    },
    "vulnerabilities": {
      "type": "object",
      "required": ["critical","high","medium","low"],
      "additionalProperties": false,
      "properties": {
        "critical": {
          "oneOf": [{"type":"integer","minimum":0},{"type":"null"}],
          "description": "Max Critical findings allowed (null = unlimited)"
        },
        "high": {
          "oneOf": [{"type":"integer","minimum":0},{"type":"null"}],
          "description": "Max High findings allowed (null = unlimited)"
        },
        "medium": {
          "oneOf": [{"type":"integer","minimum":0},{"type":"null"}],
          "description": "Max Medium findings allowed (null = unlimited)"
        },
        "low": {
          "oneOf": [{"type":"integer","minimum":0},{"type":"null"}],
          "description": "Max Low findings allowed (null = unlimited)"
        }
      }
    },
    "container": {
      "type": "object",
      "required": ["must_run_as_non_root","banned_base_tags"],
      "additionalProperties": false,
      "properties": {
        "must_run_as_non_root": {
          "type": "boolean",
          "description": "Require container to run as non-root user"
        },
        "banned_base_tags": {
          "type": "array",
          "items": {"type": "string"},
          "description": "List of banned base image tags (e.g. latest)"
        }
      }
    },
    "waivers": {
      "type": "array",
      "description": "List of approved waivers for specific findings",
      "items": {
        "type": "object",
        "required": ["id","reason","expires","approved_by"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "description": "Finding ID, CVE ID, or rule_id to waive"
          },
          "reason": {
            "type": "string",
            "description": "Business justification for the waiver"
          },
          "expires": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "ISO date when this waiver expires (YYYY-MM-DD)"
          },
          "approved_by": {
            "type": "string",
            "description": "Person or team who approved this waiver"
          },
          "scope": {
            "type": "string",
            "description": "Optional file glob to scope the waiver"
          }
        }
      }
    }
  }
}
