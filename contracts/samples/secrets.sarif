{
  "version": "2.1.0",
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "gitleaks",
          "version": "8.21.2",
          "informationUri": "https://github.com/gitleaks/gitleaks",
          "rules": [
            {
              "id": "aws-access-token",
              "name": "AWS Access Token",
              "shortDescription": {"text": "Detected a hardcoded AWS access token"},
              "helpUri": "https://docs.aws.amazon.com/general/latest/gr/aws-sec-cred-types.html"
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "aws-access-token",
          "level": "error",
          "message": {"text": "Detected a hardcoded AWS access token (FAKE - for testing only)"},
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {"uri": "demo-app/vulnerable/config.py"},
                "region": {"startLine": 10}
              }
            }
          ],
          "properties": {
            "severity": "Critical",
            "category": "secret",
            "confidence": "high",
            "raw_severity": "HIGH",
            "fix": "Remove hardcoded credential and read from environment variable or secrets manager"
          }
        }
      ]
    }
  ]
}

